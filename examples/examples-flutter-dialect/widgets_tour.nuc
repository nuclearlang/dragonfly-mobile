// A tour of the most common Flutter patterns written in Nuclear.
// Every Flutter and Dart widget and class is imported on its own.

main() void
  runApp(TourApp())

stateless TourApp
  build(context: BuildContext) Widget
    MaterialApp(
      title = 'Tour',
      theme = ThemeData(colorScheme = ColorScheme.fromSeed(seedColor = Colors.indigo), useMaterial3 = true),
      initialRoute = '/',
      routes = {
        '/': (context) => HomePage(),
        '/form': (context) => SignUpPage(),
      },
    )

Status
  alive
  dead
  unknown

Character
  (id: int, name: string, status: Status)

  toJson() <string, dynamic>
    { 'id': id, 'name': name, 'status': status.name }

parseCharacters(body: string) Character[]
  list = Json.decode(body) as dynamic[]
  list.map(item: dynamic)
    json = item as <string, dynamic>
    Character(json['id'] as int, json['name'] as string, Status.values.byName(json['status'] as string))

// Main screen: async loading, list with builder and navigation.
stateful HomePage
  characters: Character[] = []
  loading: bool = true

  initState() void
    super.initState()
    load()

  load() void
    body = ~Future.delayed(Duration(milliseconds = 300), () => '[{"id": 1, "name": "Rick", "status": "alive"}]')
    if not mounted
      return
    setState()
      characters = parseCharacters(body)
      loading = false

  build(context: BuildContext) Widget
    Scaffold(
      appBar = AppBar(
        title = Text('Characters'),
        actions = [
          IconButton(icon = Icon(Icons.person_add), onPressed = () => Navigator.pushNamed(context, '/form')),
        ],
      ),
      body = loading
        ? Center(child = CircularProgressIndicator())
        : RefreshIndicator(
          onRefresh = () => load(),
          child = ListView.builder(
            itemCount = characters.length,
            itemBuilder = (context, index)
              character = characters[index]
              ListTile(
                leading = StatusBadge(status = character.status),
                title = Text(character.name),
                onTap = () => ScaffoldMessenger.of(context).showSnackBar(
                  SnackBar(content = Text('Tapped ${character.name}')),
                ),
              )
          ),
        ),
      floatingActionButton = SpinningLogo(),
    )

// A getter and a match as a value.
stateless StatusBadge(status: Status)
  get color() Color
    match status
      Status.alive -> Colors.green
      Status.dead -> Colors.red
      _ -> Colors.grey

  build(context: BuildContext) Widget
    Container(
      padding = EdgeInsets.symmetric(horizontal = 8, vertical = 4),
      decoration = BoxDecoration(color = color, borderRadius = BorderRadius.circular(8)),
      child = Text(status.name, style = TextStyle(color = Colors.white, fontWeight = FontWeight.bold)),
    )

// Animation: the mixin goes to the State.
stateful SpinningLogo with SingleTickerProviderStateMixin
  controller: AnimationController

  initState() void
    super.initState()
    controller = AnimationController(vsync = this, duration = Duration(seconds = 2))
    controller.repeat()

  dispose() void
    controller.dispose()
    super.dispose()

  build(context: BuildContext) Widget
    RotationTransition(turns = controller, child = FlutterLogo(size = 48))

// Form: generic GlobalKey, validation and `!`.
stateful SignUpPage
  formKey: GlobalKey<FormState> = GlobalKey<FormState>()
  email: string = ''
  accepted: bool = false

  submit() void
    if not formKey.currentState!.validate()
      return
    formKey.currentState!.save()
    Navigator.pop(context)

  build(context: BuildContext) Widget
    Scaffold(
      appBar = AppBar(title = Text('Sign up')),
      body = Form(
        key = formKey,
        child = Padding(
          padding = EdgeInsets.all(16),
          child = Column(
            crossAxisAlignment = CrossAxisAlignment.stretch,
            children = [
              TextFormField(
                decoration = InputDecoration(labelText = 'Email'),
                validator = (value) => value == null or value.isEmpty ? 'Required' : null,
                onSaved = (value)
                  email = value ?? ''
              ),
              SwitchListTile(
                title = Text('I accept the terms'),
                value = accepted,
                onChanged = (value)
                  setState()
                    accepted = value
              ),
              ...List.generate(2, (i) => SizedBox(height = 8)),
              FilledButton(onPressed = accepted ? submit : null, child = Text('Send')),
            ],
          ),
        ),
      ),
    )

// A Stream with yield, if inside children and a paint with a cascade.
ticks() int
  for i in 0..60
    ~Future.delayed(Duration(seconds = 1))
    yield i

stateless Clock(showLabel: bool)
  build(context: BuildContext) Widget
    StreamBuilder<int>(
      stream = ticks(),
      builder = (context, snapshot)
        seconds = snapshot.data ?? 0
        Column(
          children = [
            CustomPaint(painter = Ring(progress = seconds / 60), size = Size(48, 48)),
            if showLabel Text('${seconds}s'),
          ],
        )
    )

Ring(progress: double): CustomPainter
  paint(canvas: Canvas, size: Size) void
    brush = Paint()
      ..color = Colors.indigo
      ..style = PaintingStyle.stroke
      ..strokeWidth = 4
    canvas.drawArc(Rect.fromLTWH(0, 0, size.width, size.height), 0, progress * 6.28, false, brush)

  shouldRepaint(oldDelegate: CustomPainter) bool
    true
