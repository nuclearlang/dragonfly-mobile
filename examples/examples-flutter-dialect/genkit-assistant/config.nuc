// The platform this project is written for and the dialect it is built with (ADR-0093).
dragonfly(platform = "mobile", dialect = "flutter")

// The project's pubspec (build/app/pubspec.yaml is written from it).
app(
  name = "genkit_assistant",
  description = "Dragonfly example: Genkit in the app (chat with tools, a flow, a knowledge base, a remote flow).",
  version = "1.0.0+1",
  usesMaterialDesign = true,
)

// The optional parts this app uses: Genkit and its OpenAI-compatible provider (a local Ollama here).
plugins(genkit = true, openAI = true)
