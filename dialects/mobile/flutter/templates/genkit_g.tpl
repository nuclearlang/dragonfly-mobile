      'required': [{{#fields}}{{^optional}}'{{name}}', {{/optional}}{{/fields}}],
    },
    parse: (json) => {{name}}.fromJson(Map<String, dynamic>.from(json as Map)),
  ));
{{/kinds.model}}
}
