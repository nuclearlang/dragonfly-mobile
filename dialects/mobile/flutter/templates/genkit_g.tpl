/// Starts Genkit with the AI providers of the connections (startDragonfly calls it).
void startGenkit() {
  final plugins = <GenkitPlugin>[];
  final added = <String>{};
  final models = <String, ModelRef<dynamic>>{};
  final embedders = <String, EmbedderRef<dynamic>>{};
  for (final c in Dragonfly.connections) {
    switch (c) {
{{#plugins.firebaseAI}}
      case FirebaseAI():
        if (added.add('firebaseAI')) {
          plugins.add(firebaseAI(provider: c.vertexAI ? const FirebaseAiProvider.agentPlatform() : const FirebaseAiProvider.googleAI()));
        }
        models[c.name] = firebaseAI.gemini(c.model);
{{/plugins.firebaseAI}}
{{#plugins.googleAI}}
      case GoogleAI():
        if (added.add('googleAI')) plugins.add(googleAI(apiKey: c.apiKey));
        models[c.name] = googleAI.gemini(c.model);
        if (c.embedder != null) embedders[c.name] = googleAI.textEmbedding(c.embedder!);
{{/plugins.googleAI}}
{{#plugins.vertexAI}}
      case VertexAI():
        if (added.add('vertexAI')) plugins.add(vertexAI(projectId: c.projectId, location: c.location));
        models[c.name] = vertexAI.gemini(c.model);
        if (c.embedder != null) embedders[c.name] = vertexAI.textEmbedding(c.embedder!);
{{/plugins.vertexAI}}
{{#plugins.openAI}}
      case OpenAI():
        if (added.add('openAI:${c.baseUrl}')) plugins.add(openAI(apiKey: c.apiKey, baseUrl: c.baseUrl));
        models[c.name] = openAI.model(c.model);
        if (c.embedder != null) embedders[c.name] = openAI.embedder(c.embedder!);
{{/plugins.openAI}}
{{#plugins.anthropic}}
      case Anthropic():
        if (added.add('anthropic')) plugins.add(anthropic(apiKey: c.apiKey));
        models[c.name] = anthropic.model(c.model);
{{/plugins.anthropic}}
      default:
        break;
    }
  }
  DragonflyGenkit.start(plugins: plugins, models: models, embedders: embedders);
{{#kinds.model}}
